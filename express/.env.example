# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/medical_scheduler
# MongoDB Atlas Cloud (Uncomment and replace placeholders):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/medical_scheduler?retryWrites=true&w=majority

# JWT Secret & Expiry
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Clinic Timezone
CLINIC_TIMEZONE=Asia/Kolkata
